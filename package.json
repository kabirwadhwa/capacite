{
  "name": "coupdepaule",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "test": "jest --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "ts-node -O '{\"module\":\"commonjs\"}' prisma/seed.ts",
    "sync:aides": "ts-node -O '{\"module\":\"commonjs\"}' scripts/sync-aides-territoires.ts",
    "curate:check": "ts-node -O '{\"module\":\"commonjs\"}' scripts/curate-check.ts",
    "purge": "ts-node -O '{\"module\":\"commonjs\"}' scripts/purge-retention.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.21.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "openai": "^7.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jest": "^29.7.0",
    "prisma": "^5.21.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
